# Copy to .env.local and fill in. Never commit .env.local.
# `npm run db:start` prints the local Supabase URL and keys.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (replaces the legacy "anon" key). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (replaces the legacy "service_role" key). Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
# local | staging | production
NEXT_PUBLIC_APP_ENV=local

# Observability. Sentry is required in production; PostHog is optional until set up.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Build time only (source map upload). Set in Vercel, not locally.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Added in later phases:
# CRON_SECRET=
# EMAIL_API_KEY=
